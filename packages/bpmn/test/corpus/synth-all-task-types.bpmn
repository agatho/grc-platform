<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Tasks" targetNamespace="http://arctos.dev/bpmn">
  <bpmn:process id="Process_Tasks" isExecutable="false">
    <bpmn:startEvent id="T_Start">
      <bpmn:outgoing>TF_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Plain" name="Task">
      <bpmn:incoming>TF_1</bpmn:incoming>
      <bpmn:outgoing>TF_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T_User" name="User Task">
      <bpmn:incoming>TF_2</bpmn:incoming>
      <bpmn:outgoing>TF_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Service" name="Service Task">
      <bpmn:incoming>TF_3</bpmn:incoming>
      <bpmn:outgoing>TF_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_Send" name="Send Task">
      <bpmn:incoming>TF_4</bpmn:incoming>
      <bpmn:outgoing>TF_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T_Receive" name="Receive Task">
      <bpmn:incoming>TF_5</bpmn:incoming>
      <bpmn:outgoing>TF_6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="T_Manual" name="Manual Task">
      <bpmn:incoming>TF_6</bpmn:incoming>
      <bpmn:outgoing>TF_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:businessRuleTask id="T_Rule" name="Business Rule Task">
      <bpmn:incoming>TF_7</bpmn:incoming>
      <bpmn:outgoing>TF_8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="T_Script" name="Script Task" scriptFormat="groovy">
      <bpmn:incoming>TF_8</bpmn:incoming>
      <bpmn:outgoing>TF_9</bpmn:outgoing>
      <bpmn:script>x = 1</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:callActivity id="T_Call" name="Call Activity" calledElement="Process_Tasks_Child">
      <bpmn:incoming>TF_9</bpmn:incoming>
      <bpmn:outgoing>TF_10</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="Loop_1"/>
    </bpmn:callActivity>
    <bpmn:endEvent id="T_End">
      <bpmn:incoming>TF_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="TF_1" sourceRef="T_Start" targetRef="T_Plain"/>
    <bpmn:sequenceFlow id="TF_2" sourceRef="T_Plain" targetRef="T_User"/>
    <bpmn:sequenceFlow id="TF_3" sourceRef="T_User" targetRef="T_Service"/>
    <bpmn:sequenceFlow id="TF_4" sourceRef="T_Service" targetRef="T_Send"/>
    <bpmn:sequenceFlow id="TF_5" sourceRef="T_Send" targetRef="T_Receive"/>
    <bpmn:sequenceFlow id="TF_6" sourceRef="T_Receive" targetRef="T_Manual"/>
    <bpmn:sequenceFlow id="TF_7" sourceRef="T_Manual" targetRef="T_Rule"/>
    <bpmn:sequenceFlow id="TF_8" sourceRef="T_Rule" targetRef="T_Script"/>
    <bpmn:sequenceFlow id="TF_9" sourceRef="T_Script" targetRef="T_Call"/>
    <bpmn:sequenceFlow id="TF_10" sourceRef="T_Call" targetRef="T_End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Tasks">
    <bpmndi:BPMNPlane id="Plane_Tasks" bpmnElement="Process_Tasks">
      <bpmndi:BPMNShape id="T_Start_di" bpmnElement="T_Start">
        <dc:Bounds x="100" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Plain_di" bpmnElement="T_Plain">
        <dc:Bounds x="180" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_User_di" bpmnElement="T_User">
        <dc:Bounds x="320" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Service_di" bpmnElement="T_Service">
        <dc:Bounds x="460" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Send_di" bpmnElement="T_Send">
        <dc:Bounds x="600" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Receive_di" bpmnElement="T_Receive">
        <dc:Bounds x="180" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Manual_di" bpmnElement="T_Manual">
        <dc:Bounds x="320" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Rule_di" bpmnElement="T_Rule">
        <dc:Bounds x="460" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Script_di" bpmnElement="T_Script">
        <dc:Bounds x="600" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Call_di" bpmnElement="T_Call">
        <dc:Bounds x="180" y="360" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_End_di" bpmnElement="T_End">
        <dc:Bounds x="340" y="382" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
