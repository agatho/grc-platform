<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Data" targetNamespace="http://arctos.dev/bpmn">
  <bpmn:dataStore id="DataStore_1" name="Kundenstamm" capacity="1000" isUnlimited="false"/>
  <bpmn:process id="Process_Data" isExecutable="false">
    <bpmn:dataStoreReference id="DataStore_Kundenstamm" name="Kundenstamm" dataStoreRef="DataStore_1"/>
    <bpmn:dataObject id="DataObject_Antrag" name="Antrag" isCollection="false"/>
    <bpmn:dataObjectReference id="DataObjectRef_Antrag" name="Antrag" dataObjectRef="DataObject_Antrag"/>
    <bpmn:startEvent id="D_Start">
      <bpmn:outgoing>DF_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="D_Task_Erfassen" name="Antrag erfassen">
      <bpmn:incoming>DF_1</bpmn:incoming>
      <bpmn:outgoing>DF_2</bpmn:outgoing>
      <bpmn:property id="Prop_1" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssoc_1">
        <bpmn:sourceRef>DataStore_Kundenstamm</bpmn:sourceRef>
        <bpmn:targetRef>Prop_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_1">
        <bpmn:targetRef>DataObjectRef_Antrag</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="D_Task_Regel" name="Bonitaet bewerten">
      <bpmn:incoming>DF_2</bpmn:incoming>
      <bpmn:outgoing>DF_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="D_End">
      <bpmn:incoming>DF_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="DF_1" sourceRef="D_Start" targetRef="D_Task_Erfassen"/>
    <bpmn:sequenceFlow id="DF_2" sourceRef="D_Task_Erfassen" targetRef="D_Task_Regel"/>
    <bpmn:sequenceFlow id="DF_3" sourceRef="D_Task_Regel" targetRef="D_End"/>
    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>Pruefung nach § 18 KWG — Vier-Augen-Prinzip</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="D_Task_Regel" targetRef="TextAnnotation_1" associationDirection="None"/>
    <bpmn:group id="Group_1" categoryValueRef="CategoryValue_1"/>
  </bpmn:process>
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_1" value="Kernprozess"/>
  </bpmn:category>
  <bpmndi:BPMNDiagram id="Diagram_Data">
    <bpmndi:BPMNPlane id="Plane_Data" bpmnElement="Process_Data">
      <bpmndi:BPMNShape id="D_Start_di" bpmnElement="D_Start">
        <dc:Bounds x="152" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Task_Erfassen_di" bpmnElement="D_Task_Erfassen">
        <dc:Bounds x="240" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Task_Regel_di" bpmnElement="D_Task_Regel">
        <dc:Bounds x="400" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_End_di" bpmnElement="D_End">
        <dc:Bounds x="560" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_Kundenstamm_di" bpmnElement="DataStore_Kundenstamm">
        <dc:Bounds x="265" y="45" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="253" y="102" width="74" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_Antrag_di" bpmnElement="DataObjectRef_Antrag">
        <dc:Bounds x="272" y="305" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_1_di" bpmnElement="TextAnnotation_1">
        <dc:Bounds x="560" y="60" width="180" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Group_1_di" bpmnElement="Group_1">
        <dc:Bounds x="220" y="130" width="300" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DF_1_di" bpmnElement="DF_1">
        <di:waypoint x="188" y="200"/>
        <di:waypoint x="240" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DF_2_di" bpmnElement="DF_2">
        <di:waypoint x="340" y="200"/>
        <di:waypoint x="400" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DF_3_di" bpmnElement="DF_3">
        <di:waypoint x="500" y="200"/>
        <di:waypoint x="560" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_1_di" bpmnElement="Association_1">
        <di:waypoint x="470" y="160"/>
        <di:waypoint x="560" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInputAssoc_1_di" bpmnElement="DataInputAssoc_1">
        <di:waypoint x="290" y="95"/>
        <di:waypoint x="290" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutputAssoc_1_di" bpmnElement="DataOutputAssoc_1">
        <di:waypoint x="290" y="240"/>
        <di:waypoint x="290" y="305"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
