# Database (ADR-005 / #SEC-F01)
#
# Two connection URLs, split by privilege:
#   DATABASE_URL      — superuser `grc`. Used by MIGRATIONS, seeds,
#                       create-missing-tables and provisioning. Also the
#                       runtime FALLBACK when APP_DATABASE_URL is unset.
#   APP_DATABASE_URL  — non-superuser `grc_app` (no BYPASSRLS). The RUNTIME
#                       app pool (apps/web + apps/worker) uses this so that
#                       Row-Level Security is actually enforced. In code:
#                       runtime = APP_DATABASE_URL ?? DATABASE_URL.
#
# Development: leaving APP_DATABASE_URL unset means the app runs as the
# superuser and RLS is NOT enforced (fine for local work). To exercise RLS
# locally, create the grc_app role and set APP_DATABASE_URL:
#   DIRECT_PSQL=1 GRC_APP_PASSWORD=grc_app_dev_password \
#     bash deploy/provision-grc-app.sh grc_platform
# Production MUST set APP_DATABASE_URL (see docker-compose.production.yml).
DATABASE_URL=postgresql://grc:grc_dev_password@localhost:5432/grc_platform
# APP_DATABASE_URL=postgresql://grc_app:grc_app_dev_password@localhost:5432/grc_platform

# ──────────────────────────────────────────────────────────────
# Seeding (docker-entrypoint.sh) — #SEC-F04
# ──────────────────────────────────────────────────────────────
# RUN_SEEDS=true seeds catalog/reference data (frameworks, mappings).
# RUN_SEEDS=false
#
# SEED_DEMO_DATA=true additionally seeds DEMO + RBAC-test organizations and
# accounts with KNOWN, published passwords (admin@arctos.dev, *@arctistx.test,
# ...). For any REAL instance this MUST stay false — otherwise the platform
# ships with working backdoor logins.
# SEED_DEMO_DATA=false
#
# Safety guard: if NODE_ENV=production the demo seed is refused even when
# SEED_DEMO_DATA=true, UNLESS you also set ALLOW_DEMO_SEED_IN_PROD=true. Only
# ever set this on a throwaway/demo box, never on a tenant with real data.
# ALLOW_DEMO_SEED_IN_PROD=false

# Auth.js (ADR-007 rev.1)
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Azure AD / Microsoft Entra ID SSO (S1-07, optional — uncomment and fill to enable)
# Register an app in Azure Portal > Microsoft Entra ID > App registrations.
# Set the redirect URI to: {AUTH_URL}/api/auth/callback/microsoft-entra-id
# Required scopes: openid, profile, email
# AZURE_AD_CLIENT_ID=<Application (client) ID from Azure Portal>
# AZURE_AD_CLIENT_SECRET=<Client secret value from Certificates & secrets>
# AZURE_AD_TENANT_ID=<Directory (tenant) ID — restricts login to your organization>

# AI Providers (ADR-008) — configure one or more, first available is used as default
# Set AI_DEFAULT_PROVIDER to override (claude_cli | claude_api | openai | gemini | ollama | lmstudio)
AI_DEFAULT_PROVIDER=claude_cli

# Claude via CLI (uses your Claude subscription — no API key needed)
# Requires: claude CLI installed and authenticated (claude.ai login)
# Set CLAUDE_CLI_PATH if not in PATH (default: "claude")
# CLAUDE_CLI_PATH=/home/grctool/.local/bin/claude
# CLAUDE_CLI_ENABLED=true

# Claude API (Anthropic) — separate pay-per-token billing
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o, GPT-4-turbo)
# OPENAI_API_KEY=sk-...

# Google Gemini (free tier: 15 RPM, 1M tokens/day)
# GOOGLE_AI_API_KEY=AIza...

# Ollama (local models, GDPR-safe) — for privacy-sensitive data
# Personal data is automatically routed to Ollama when available
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_ENABLED=true

# LM Studio (local models with GUI, OpenAI-compatible API, GDPR-safe)
# Fallback for privacy routing when Ollama is not available
# LMSTUDIO_BASE_URL=http://localhost:1234
# LMSTUDIO_ENABLED=true
# LMSTUDIO_DEFAULT_MODEL=local-model

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV gehört NICHT in .env-Files (non-standard-node-env):
# Next.js setzt es selbst (dev=development, build/start=production).
# Ein NODE_ENV=development hier bricht seit Next 16 den `next build`
# (React-Dev/Prod-Mismatch -> "Cannot read properties of null
# (reading 'useContext')" beim /_global-error-Prerender).
# https://nextjs.org/docs/messages/non-standard-node-env

# ─────────────────────────────────────────────────────────────────────
# Worker, Scheduler und Cron-Jobs   [ARCTOS-FULL-2026-08-31 / WP9]
# ─────────────────────────────────────────────────────────────────────
# Shared Secret für POST /crons/* am Worker (Header X-Cron-Secret).
# Fail-closed: ist es nicht gesetzt, antwortet der Worker mit 500 statt
# den Endpunkt zu öffnen.
CRON_SECRET=arctos-cron-secret-change-in-production

# [S10-02] Der In-Process-Scheduler. Vor diesem Audit gab es KEINEN
# Scheduler: die 128 Cron-Jobs waren nur HTTP-Endpunkte, und nichts im
# Repository rief sie auf — keine Frist wurde überwacht, nichts gelöscht,
# der Audit-Trail nicht verankert. "false" nur setzen, wenn ausnahmsweise
# ein externer Scheduler die Endpunkte treibt; beide Wege nehmen denselben
# Advisory Lock, ein Mischbetrieb kann also nicht doppelt ausführen.
CRON_SCHEDULER_ENABLED=true
# Aufbewahrung des Laufprotokolls `job_run` in Tagen (Fehlläufe: doppelt).
JOB_RUN_RETENTION_DAYS=90
# Lease-Timeouts für Queue-Zeilen, die ein abgestürzter Worker auf
# "running" stehen gelassen hat (Minuten).
IMPORT_JOB_LEASE_MINUTES=30
EVIDENCE_REVIEW_LEASE_MINUTES=30

# [S01-09] Datenbankrolle des Workers. Der Worker braucht BYPASSRLS für
# seine org-übergreifenden Systemjobs — aber KEIN SUPERUSER. Die Rolle
# legt deploy/provision-grc-app.sh an, sobald diese Variable gesetzt ist:
#   GRC_APP_PASSWORD=… GRC_WORKER_PASSWORD=… bash deploy/provision-grc-app.sh grc_platform
# Verbindet der Worker in Produktion trotzdem als Superuser, beendet er
# sich selbst (apps/worker/src/lib/db-role-guard.ts).
GRC_WORKER_PASSWORD=grc_worker_dev_password
# Erlaubt dem Worker die privilegierte (BYPASSRLS-)Verbindung. Die
# Startup-Assertion in packages/db verlangt diese Zustimmung explizit,
# damit sie im Deployment sichtbar und einzeln widerrufbar ist. Für die
# WEB-App darf sie niemals gesetzt sein.
ARCTOS_ALLOW_PRIVILEGED_DB=true

# [WP4 · S03-01] Signaturschlüssel der Audit-Anker-Siegel. Wird von Worker
# (daily-audit-anchor, audit-chain-verify) UND Web (/api/v1/audit-log/
# integrity) gebraucht. Ohne ihn sind die Anker zwar verkettet, aber nicht
# signiert; /integrity meldet `anchor_unsealed`.
# Generieren: openssl rand -hex 32
AUDIT_SEAL_KEY=generate-a-64-char-hex-key-here-do-not-use-in-production
AUDIT_SEAL_KEY_ID=k1
# Wie viele Tage rückwirkend nicht verankerte Tage nachgeholt werden.
AUDIT_ANCHOR_RETRY_DAYS=14

# ─────────────────────────────────────────────────────────────────────
# Rate Limiting   [ARCTOS-FULL-2026-08-31 / WP9 · S10-05, ADR-019]
# ─────────────────────────────────────────────────────────────────────
# Anzahl eigener Reverse-Proxys vor der App. Bestimmt, welchem
# X-Forwarded-For-Eintrag geglaubt wird: gezählt wird von RECHTS, weil
# jeder Proxy anhängt statt zu ersetzen. Vor diesem Audit nahm der Code
# den ERSTEN (= vom Client gelieferten) Eintrag — ein Header pro Versuch
# genügte, um das Login-Limit vollständig zu umgehen.
#   0 = X-Forwarded-For ignorieren (App direkt exponiert)
#   1 = ein Caddy davor (Standard dieses Deployments)
#   2 = CDN vor Caddy
TRUSTED_PROXY_HOPS=1
# Budgets im Format "<Anzahl>/<Sekunden>". Leer = Vorgaben aus
# apps/web/src/lib/rate-limit.ts. ADR-019 hat diese Variablen
# versprochen; gelesen hat sie bis zu diesem Audit niemand.
RATE_LIMIT_DEFAULT=300/60
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_COPILOT=30/60
RATE_LIMIT_AI=10/60
RATE_LIMIT_IMPORT=5/3600
RATE_LIMIT_EXPORT=10/3600
RATE_LIMIT_UPLOAD=60/60
RATE_LIMIT_PORTAL=30/60
RATE_LIMIT_INTAKE=5/600
# Obergrenze der Token-Bucket-Map. Vorher unbegrenzt und mit einem
# angreiferkontrollierten Schlüssel — ein langsames Speicherleck (S10-23).
RATE_LIMIT_MAX_BUCKETS=50000

# Whistleblowing Encryption (REQUIRED for Sprint 12)
# Verschluesselung at rest (AES-256-GCM) von Meldungstexten, Kontaktadressen
# und Fallnachrichten. NICHT Ende-zu-Ende: der Server haelt den Schluessel.
# Ohne diesen Wert weist das Meldeportal eingehende Meldungen mit 503 ab
# (#WP8-S07-19) statt sie mit einem 500 zu verlieren.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WB_ENCRYPTION_KEY=generate-a-64-char-hex-key-here-do-not-use-in-production

# Rotationspfad (#WP8-S07-19.2): waehrend einer Rotation den alten Schluessel
# hier eintragen; Bestandschiffrate bleiben lesbar. Nach dem Re-Seal entfernen.
# WB_ENCRYPTION_KEY_PREVIOUS=
# WB_ENCRYPTION_KEY_ID=default

# HMAC-Schluessel fuer die Pseudonymisierung der Melder-IP (#WP8-S07-02).
# Fehlt er, wird er aus WB_ENCRYPTION_KEY abgeleitet.
# WB_PSEUDONYM_KEY=generate-a-64-char-hex-key-here-do-not-use-in-production

# HMAC-Schluessel fuer die Pseudonymisierung im Audit-Trail und im
# Hinweisgeber-Fachlog (#WP8-S07-03/-08). Er darf NICHT in derselben
# Datenbank liegen, deren Inhalt er pseudonymisiert — sonst steht das
# "zusaetzliche Wissen" nach Art. 4 Nr. 5 DSGVO neben den Daten. Ohne ihn
# greift ein Installationsschluessel in der Tabelle pii_pseudonym_key
# (deny-all, fuer keine Anwendungsrolle lesbar), was schwaecher ist.
# PII_PSEUDONYM_KEY=generate-a-64-char-hex-key-here-do-not-use-in-production
# PII_PSEUDONYM_KEY_ID=default

# Connector Credential Encryption (REQUIRED when connectors are active)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: rotating this key invalidates every stored credential row.
# Use a different value than WB_ENCRYPTION_KEY.
CONNECTOR_ENCRYPTION_KEY=generate-a-64-char-hex-key-here-do-not-use-in-production

# Application-Secret Encryption at rest (REQUIRED when SSO/OIDC or
# connector OAuth refresh tokens are used). Encrypts single-column
# secrets (sso_config.oidc_client_secret, connector_credential.
# refresh_token) via packages/shared/src/secret-crypto.ts.
# Generate with: openssl rand -base64 32   (hex also accepted)
# Use a different value than WB_/CONNECTOR_ENCRYPTION_KEY.
SECRET_ENCRYPTION_KEY=generate-a-32-byte-base64-key-here-do-not-use-in-production
# Key rotation: set the OLD key here, deploy, run
# scripts/encrypt-connector-secrets.mjs (re-seals under the new key),
# then remove it again.
# SECRET_ENCRYPTION_KEY_PREVIOUS=

# Email (Resend)
RESEND_API_KEY=re_test_placeholder
RESEND_FROM_EMAIL=noreply@arctos.local
RESEND_FROM_NAME=ARCTOS GRC Platform
EMAIL_ENABLED=false

# ──────────────────────────────────────────────────────────────
# Backfilled by dep-config-hygiene-2026-05-23 §quick-win #1 —
# operator-facing keys that code reads but .env.example didn't list.
# ──────────────────────────────────────────────────────────────

# Auth.js public base URL — REQUIRED in production. SSO/SCIM/SAML
# routes all use this for callback URLs. Without it, OIDC callbacks
# default to localhost (caught by getBaseUrl() helper). Alias of
# AUTH_URL; both are accepted.
# NEXTAUTH_URL=https://arctos.charliehund.de

# Rate-limit + cache backing store. Without it, rateLimit() falls
# back to per-pod in-memory buckets (NOT shared across instances —
# multi-pod deploys lose enforcement). Required for production.
# REDIS_URL=redis://localhost:6379

# File-upload base directory for documents (download endpoint reads
# from here). Defaults to <cwd>/../../uploads/documents.
# UPLOAD_DIR=/var/lib/arctos/uploads

# ──────────────────────────────────────────────────────────────
# DMS file storage backend (web + worker). Default "local" keeps the
# historical fs behavior under UPLOAD_DIR — existing files stay
# readable without migration (stored keys = file_path column).
# "s3" targets any S3-compatible store (AWS S3, MinIO) via SigV4-
# signed fetch — no AWS SDK dependency.
# ──────────────────────────────────────────────────────────────
# STORAGE_BACKEND=local
# S3_ENDPOINT=http://localhost:9000        # MinIO etc.; omit for AWS S3
# S3_REGION=us-east-1
# S3_BUCKET=arctos-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1                    # required for MinIO

# ──────────────────────────────────────────────────────────────
# ClamAV malware scanning for document uploads (optional). When
# CLAMAV_HOST is unset, scanning is skipped (scan_status=skipped) with
# a one-time log notice. Scan ERRORS (daemon unreachable, timeout) are
# fail-open by default so a missing ClamAV container never blocks
# uploads; set CLAMAV_FAIL_CLOSED=1 to reject uploads instead (503).
# Infected files are always rejected (422) + audit-logged.
# ──────────────────────────────────────────────────────────────
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# CLAMAV_FAIL_CLOSED=0

# Webhook outbound safety (#SEC-HIGH-SSRF protections)
# Allow webhooks to reach private hostnames/IPs — DEV ONLY. Default
# false; setting to "1" disables the checkResolvedHostIsPublic guard.
WEBHOOK_ALLOW_PRIVATE_HOSTS=0
# Allow webhook URLs over plain http://. Default false (https only).
WEBHOOK_ALLOW_HTTP=0

# Worker observability
# Log level for the structured NDJSON logger (apps/web + apps/worker).
# trace|debug|info|warn|error|fatal — default "info".
# ARCTOS_LOG_LEVEL=info
# Service name in log lines + traces. Defaults to "arctos-web" /
# "arctos-worker" per package; override only for staging/canary tags.
# ARCTOS_SERVICE=arctos-web

# Build metadata (server- + client-side). CI sets these at image
# build time; leave blank in dev.
# APP_VERSION=0.1.0-alpha
# BUILD_TIME=2026-05-23T12:00:00Z
# GIT_BRANCH=main
# GIT_SHA=abcdef123
# NEXT_PUBLIC_BUILD_TIME=2026-05-23T12:00:00Z
# NEXT_PUBLIC_GIT_BRANCH=main
# NEXT_PUBLIC_GIT_SHA=abcdef123

# Public portal base URL for supplier DD portal links in email
# templates. Falls back to NEXTAUTH_URL if unset.
# PORTAL_BASE_URL=https://portal.arctos.charliehund.de

# Regulatory feed sources (regulatory-change-detection cron). All
# optional — the cron skips a source if the URL isn't set.
# BSI_FEED_URL=https://www.bsi.bund.de/SiteGlobals/Functions/RSSFeed/...
# BAFIN_FEED_URL=https://www.bafin.de/SharedDocs/RSS/EN/Feeds/...
# EURLEX_FEED_URL=https://eur-lex.europa.eu/EN/legal-content/...
# NVD API key — optional; without it the CVE-feed cron uses the
# anonymous rate limit (5 req/30s instead of 50 req/30s).
# NVD_API_KEY=

# Server port (apps/web). Defaults to 3000.
# PORT=3000
