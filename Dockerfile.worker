# ============================================================================
# ARCTOS Worker — Production Docker Image
# Hono.js Cron-Server fuer Background Jobs
# ============================================================================
#
# #DEP-CONFIG: base image pinned to a specific minor.patch tag (was
# previously `node:22-alpine` — a moving tag that could pick up a new
# minor each rebuild). See apps/web/Dockerfile for the digest-pinning
# alternative if maximum immutability is needed.
#
# #SEC-IMG-SLIM (Pentest v2 / Trivy): the previous build ran a full
# `npm ci` at the monorepo root, which pulled EVERY devDependency —
# including Playwright, vitest, typescript and drizzle-kit — into the
# runtime image (~5.6 GB). Those never run in the worker at runtime but
# ballooned the attack surface and dragged in the bulk of the node-pkg
# CVEs Trivy flagged (npm-bundled tar/minimatch, build-tool glob, etc.).
# This build installs PRODUCTION deps only (`npm ci --omit=dev`) and adds
# back just `tsx` (the TS runtime executor, otherwise a devDependency) as
# a small global install — so no package.json / package-lock.json change
# is required. Expect the image to shrink by multiple GB.

# [ARCTOS-FULL-2026-08-31 / WP10 · S08-21] Digest-Pinning.
# Der Tag `node:22.20-alpine` ist innerhalb der Patch-Linie beweglich: zwei
# Builds desselben Commits ergaben unterschiedliche Images. Fuer ein Produkt
# mit Auditierbarkeitsanspruch heisst das, dass sich von einem laufenden
# Container nicht auf einen reproduzierbaren Bauzustand zurueckschliessen
# laesst. Der Digest unten ist bit-identisch-oder-Fehlschlag; der Tag bleibt
# als Kommentar stehen, damit ein Bump lesbar ist. Dependabot bumpt
# `docker`-Ecosystem-Digests automatisch (.github/dependabot.yml).
# Ermittelt am 2026-09-01 mit:
#   docker buildx imagetools inspect node:22.20-alpine --format '{{.Manifest.Digest}}'
ARG NODE_IMAGE=node:22.20-alpine@sha256:dbcedd8aeab47fbc0f4dd4bffa55b7c3c729a707875968d467aaaea42d6225af
ARG TSX_VERSION=4.23.1

# ── deps: production dependencies only ──────────────────────────────────────
FROM ${NODE_IMAGE} AS deps
WORKDIR /app

COPY package.json package-lock.json turbo.json ./
COPY apps/worker/package.json apps/worker/
COPY packages/ai/package.json packages/ai/
COPY packages/db/package.json packages/db/
COPY packages/email/package.json packages/email/
COPY packages/events/package.json packages/events/
COPY packages/shared/package.json packages/shared/
COPY packages/automation/package.json packages/automation/
COPY packages/graph/package.json packages/graph/
COPY packages/reporting/package.json packages/reporting/
COPY packages/auth/package.json packages/auth/
COPY packages/ui/package.json packages/ui/

# --omit=dev drops root + workspace devDependencies (Playwright, vitest,
# typescript, drizzle-kit, tsx, …). Prod deps still land in their per-
# workspace node_modules, so the full /app copy below stays correct.
RUN npm ci --omit=dev --ignore-scripts

# ── runner ──────────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS runner
WORKDIR /app

# Pull Alpine security patches into the runtime layer — see comment
# in apps' Dockerfile for context. Same Trivy gate applies to the
# worker image.
RUN apk upgrade --no-cache

# tsx is the runtime executor (CMD below) but is a devDependency, so it is
# NOT in the --omit=dev tree. Install it globally instead of moving it to
# `dependencies` — that keeps package.json/package-lock.json untouched.
# tsx bundles esbuild and transpiles the TS worker + @grc/* workspace
# sources on the fly, so no separate `typescript` install is needed.
RUN npm install -g "tsx@${TSX_VERSION}" && npm cache clean --force

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 arctos && \
    adduser --system --uid 1001 arctos

# Copy the prod-only deps-stage /app — brings the root node_modules AND
# every per-workspace node_modules (npm workspaces don't hoist every dep;
# @anthropic-ai/sdk for example lives only in packages/ai/node_modules/).
COPY --from=deps /app ./

# [ARCTOS-FULL-2026-08-31 / WP10 · S08-11]
# Vorher stand hier `COPY . .` — der komplette Quellbaum landete im
# Runtime-Image: 412 getrackte Testdateien, `deploy/` mit
# setup-hetzner.sh / harden-server.sh / create-tenant.sh / db-backup.sh /
# offsite-sync.sh / Caddyfile / provision-grc-app.sh, beide Compose-Dateien
# und 81 SQL-Skripte. Wer ueber eine andere Schwachstelle Dateizugriff im
# Container erlangte, fand dort die vollstaendige Betriebstopologie der
# Zielumgebung. Das Web-Image machte es bereits richtig (selektives COPY aus
# der Builder-Stage).
#
# Kopiert wird jetzt gezielt, was der Worker zur Laufzeit braucht:
# Manifeste (Workspace-Aufloesung), Worker-Quellen, Package-Quellen und die
# Migrations-/Seed-SQL, die einige Jobs lesen. `.dockerignore` schliesst
# Tests, deploy/, Compose und Doku zusaetzlich aus — beide Massnahmen
# zusammen, damit ein spaeteres `COPY . .` nicht wieder alles hereinholt.
COPY package.json package-lock.json turbo.json tsconfig.base.json ./
COPY apps/worker/package.json apps/worker/tsconfig.json apps/worker/
COPY apps/worker/src apps/worker/src
COPY packages packages
COPY scripts/prestart.sh /app/prestart.sh
COPY scripts/assert-runtime-config.mjs /app/scripts/assert-runtime-config.mjs
# [WP10 · S13-11/S13-12] Der Metrik- und Alarmdienst laeuft aus DIESEM Image
# (Compose-Service `ops-metrics`, eigener entrypoint). Er nutzt den
# `postgres`-Client aus dem Produktionsbaum — deshalb braucht das Image
# kein zusaetzliches postgresql-client-Paket (#S08-11).
COPY scripts/ops-metrics.mjs /app/scripts/ops-metrics.mjs

# [WP10 · S08-16 / S08-12] Namensnennung und Stueckliste im Image.
COPY NOTICE THIRD-PARTY-LICENSES.md ./
COPY SBOM/arctos-sbom-prod.cdx.json SBOM/arctos-sbom-prod.cdx.json

RUN chmod +x /app/prestart.sh

USER arctos

EXPOSE 3001

# [WP10 · S13-13] Der Worker-Healthcheck aus WP9 (S10-21) wird hier im
# Image verankert, damit er auch ausserhalb der Produktions-Compose gilt
# (deploy/docker-compose.yml, k8s, `docker run`).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/health')\
    .then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# [WP10 · S13-10] Pflichtkonfiguration vor dem Start pruefen. Ohne
# GRC_WORKER_PASSWORD, AUDIT_SEAL_KEY oder PII_PSEUDONYM_KEY startet der
# Worker in NODE_ENV=production nicht mehr.
# Use the global tsx (on PATH) rather than `npx tsx` — npx would try to
# resolve/-install tsx from the (now dev-pruned) local tree.
ENTRYPOINT ["/app/prestart.sh", "worker"]
CMD ["tsx", "apps/worker/src/index.ts"]
