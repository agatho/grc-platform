// [N-2 · Welle 6a] `noUnusedLocals` steht jetzt an.
//
// Diese Datei erbt NICHT von `tsconfig.base.json` (anders als die elf
// Pakete unter `packages/`), der Schalter musste deshalb hier gesetzt
// werden. Gemessen am 2026-09-07 vor dem Anschalten: 138 eigene
// Fundstellen unter `src/`, alle abgetragen — keine per `!`, keine per
// `as`, keine per `// @ts-expect-error`.
//
// Was dabei ans Licht kam, steht in `docs/UMSETZUNG-WELLE-6A.md` §5. Der
// haerteste Fall: `crons/risk-prediction-weekly.ts` importierte seine
// gesamte Vorhersagemaschinerie und benutzte nichts davon — der Job lief
// jede Woche und quittierte Erfolg, ohne etwas zu tun.
//
// `include` deckt `src/**/*.ts` ab; `tests/**` ist ueber `exclude`
// (`**/*.test.ts`) und den fehlenden Pfad nicht Teil dieses Programms.
// Der Testbaum wird von vitest uebersetzt, nicht von diesem Projekt.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
