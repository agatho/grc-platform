# ============================================================================
# ARCTOS GRC Platform — Environment Configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.sample .env
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ── Database ────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_use_a_strong_password

# ── Laufzeitrollen (#S13-09a) — PFLICHT ────────────────────────
# Bis zum Audit 2026-08-31 kannte diese Datei WEDER `GRC_APP_PASSWORD`
# NOCH `APP_DATABASE_URL`. Der Stack lief dadurch vollstaendig als
# Superuser `grc` (BYPASSRLS) und saemtliche RLS-Policies waren
# wirkungslos — ohne jedes Signal und ohne einen dokumentierten Weg, das
# zu korrigieren. Der Service `provision-roles` legt beide Rollen beim
# ersten Start an.
#   grc_app     — Laufzeit der Web-App, KEIN BYPASSRLS
#   grc_worker  — Cron-Jobs, BYPASSRLS aber KEIN SUPERUSER
# Erzeugen: openssl rand -hex 24
GRC_APP_PASSWORD=CHANGE_ME_openssl_rand_hex_24
GRC_WORKER_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ── Audit-Siegel und Pseudonymisierung — PFLICHT ───────────────
# AUDIT_SEAL_KEY (WP4/S03-01): HMAC-Siegel der Audit-Anker. Ohne ihn ist
#   die Hash-Kette Integritaetspruefung, aber keine Tamper-Evidence gegen
#   einen Datenbank-Superuser.
# PII_PSEUDONYM_KEY (WP8/S07-03): ohne ihn greift ein Installations-
#   schluessel IN der Datenbank — das "zusaetzliche Wissen" nach
#   Art. 4 Nr. 5 DSGVO laege dann im selben Dump wie die Daten.
# BEIDE sind NICHT beliebig rotierbar (siehe docs/runbook.md §7) und
# gehoeren in eine Schluesselablage AUSSERHALB dieses Hosts.
# Erzeugen: openssl rand -hex 32
AUDIT_SEAL_KEY=CHANGE_ME_openssl_rand_hex_32
PII_PSEUDONYM_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Authentication (REQUIRED) ──────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=CHANGE_ME_generate_with_command_above
AUTH_URL=http://localhost:3000

# ── Whistleblowing Encryption (REQUIRED) ───────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WB_ENCRYPTION_KEY=CHANGE_ME_generate_with_command_above

# ── Connector Credential Encryption (REQUIRED when connectors are active) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value than WB_ENCRYPTION_KEY.
CONNECTOR_ENCRYPTION_KEY=CHANGE_ME_generate_with_command_above

# ── Application-Secret Encryption (REQUIRED for SSO/OIDC + OAuth connectors) ──
# Encrypts sso_config.oidc_client_secret and connector_credential.refresh_token
# at rest. Generate: openssl rand -base64 32
# Use a DIFFERENT value than WB_/CONNECTOR_ENCRYPTION_KEY.
SECRET_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
# Rotation fallback (only set while rotating, then remove):
# SECRET_ENCRYPTION_KEY_PREVIOUS=

# ── Internal Security ──────────────────────────────────────────
CRON_SECRET=CHANGE_ME_any_random_string
REDIS_PASSWORD=CHANGE_ME_any_random_string

# ── TLS / Reverse-Proxy (#S13-09d) — PFLICHT ───────────────────
# Ohne diese beiden Werte startet der caddy-Service nicht. Vor dem Audit
# lief der Stack auf reinem HTTP an allen Interfaces, und das README wies
# genau das an ("http://your-server:3000") — Session-Cookies und
# Anmeldedaten gingen im Klartext ueber das Netz.
ARCTOS_DOMAIN=grc.ihre-domain.de
ACME_EMAIL=ops@ihre-domain.de

# ── Application ────────────────────────────────────────────────
# #S13-09d: der Klartext-Port ist an 127.0.0.1 gebunden und nur fuer den
# Reverse-Proxy erreichbar. BIND_ADDRESS=0.0.0.0 oeffnet ihn bewusst
# nach aussen — nur fuer lokale Tests, nie fuer eine Instanz mit Echtdaten.
BIND_ADDRESS=127.0.0.1
PORT=3000
IMAGE_TAG=latest
# AUTH_URL MUSS die oeffentliche https-Adresse sein, nicht localhost —
# sonst zeigen SSO-/SCIM-/SAML-Callbacks ins Leere.
# AUTH_URL=https://grc.ihre-domain.de

# ── First Run ──────────────────────────────────────────────────
# RUN_SEEDS spielt KATALOG- und REFERENZDATEN ein (Frameworks, Mappings).
# Das ist kein Demo-Inhalt und darf anbleiben.
RUN_SEEDS=true
#
# #S13-09e: DEMO-DATEN GIBT ES HIER NICHT MEHR. Frueher stand im README
# "Login: admin@arctos.dev / admin123" — dieser Account entsteht nur aus
# dem Demo-Seed, den der Entrypoint in Produktion verweigert. Wer dem
# README folgte, konnte sich nicht anmelden und setzte plausibel
# ALLOW_DEMO_SEED_IN_PROD=true, womit ein Admin-Konto mit oeffentlich
# bekanntem Passwort in Produktion landete.
#
# Der Erstadministrator wird stattdessen einmalig angelegt:
#   ADMIN_EMAIL=chef@firma.de docker compose run --rm create-admin
# Das Kommando gibt ein zufaelliges Erstpasswort aus und erzwingt die
# Aenderung bei der ersten Anmeldung.

# ── AI Features (optional) ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=...
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Email (optional) ───────────────────────────────────────────
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# EMAIL_ENABLED=true

# ── Azure AD SSO (optional) ────────────────────────────────────
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
